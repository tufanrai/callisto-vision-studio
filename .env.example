# Canonical origin. Drives metadataBase, canonical URLs, sitemap.xml,
# robots.txt and every JSON-LD @id. Set this per environment — without it the
# build falls back to https://callistovisionstudio.com.
NEXT_PUBLIC_SITE_URL=https://callistovisionstudio.com

# --- Contact form delivery (optional) ---------------------------------------
# Without RESEND_API_KEY the /api/contact endpoint returns a 503 telling the
# visitor to email directly, rather than pretending the enquiry was sent.
# Get a key at https://resend.com
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to the studio address in lib/site.ts.
CONTACT_TO_EMAIL=

# Must be a domain you have verified with Resend.
CONTACT_FROM_EMAIL=enquiries@callistovisionstudio.com
